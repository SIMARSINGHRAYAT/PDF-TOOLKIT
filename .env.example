# Optional: enables the database-backed /api/health check.
# The PDF tools work without a database because processing happens in the browser.
DATABASE_URL=

# Optional public limits. Values are in MB, file count, and pages per document.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=100
NEXT_PUBLIC_MAX_FILES_PER_OPERATION=50
NEXT_PUBLIC_MAX_PAGES_PER_DOCUMENT=500